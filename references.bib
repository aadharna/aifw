@article{Cherniak2004,
  abstract      = {Functional areas of mammalian cerebral cortex seem positioned to minimize costs of their interconnections, down to a best-in-a-billion optimality level. The optimization problem here, originating in microcircuit design, is: Given connections among components, what is the physical placement of the components on a surface that minimizes total length of connections? Because of unfeasibility of measuring long-range "wire length" in the cortex, a simpler adjacency cost was validated. To deal with incomplete information on brain networks, a size law was developed that predicts optimization patterns in subnetworks. Macaque and cat cortex rank better in this connection optimization than the wiring of comparably structured computer chips, but somewhat worse than the macroeconomic commodity-flow network among U.S. states. However, cortex wiring conforms to the size law better than the macroeconomic patterns, which may indicate cortex optimizing mechanisms involve more global processes.},
  author        = {Cherniak, C. and Mokhtarzada, Z. and Rodriguez-Esteban, R. and Changizi, K.},
  bdsk-url-1    = {http://dx.doi.org/10.1073/pnas.0305212101},
  date-added    = {2013-09-14 03:27:34 +0000},
  date-modified = {2014-07-20 17:49:02 +0000},
  doi           = {10.1073/pnas.0305212101},
  issn          = {0027-8424},
  journal       = {Proceedings of the National Academy of Sciences},
  keywords      = {Animals,Cats,Cerebral Cortex,Cerebral Cortex: anatomy \& histology,Cerebral Cortex: physiology,Macaca,Nerve Net},
  month         = {1},
  number        = {4},
  pages         = {1081--6},
  pmid          = {14722353},
  title         = {{Global optimization of cerebral cortex layout.}},
  volume        = {101},
  year          = {2004}
}

