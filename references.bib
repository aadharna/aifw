@article{Wen2008,
  abstract      = {Over hundreds of millions of years, evolution has optimized brain design to maximize its functionality while minimizing costs associated with building and maintenance. This observation suggests that one can use optimization theory to rationalize various features of brain design. Here, we attempt to explain the dimensions and branching structure of dendritic arbors by minimizing dendritic cost for given potential synaptic connectivity. Assuming only that dendritic cost increases with total dendritic length and path length from synapses to soma, we find that branching, planar, and compact dendritic arbors, such as those belonging to Purkinje cells in the cerebellum, are optimal. The theory predicts that adjacent Purkinje dendritic arbors should spatially segregate. In addition, we propose two explicit cost function expressions, falsifiable by measuring dendritic caliber near bifurcations.},
  author        = {Wen, Quan and Chklovskii, Dmitri B},
  bdsk-url-1    = {http://www.ncbi.nlm.nih.gov/pubmed/18305091},
  bdsk-url-2    = {http://dx.doi.org/10.1152/jn.00280.2007},
  date-added    = {2013-09-14 03:30:36 +0000},
  date-modified = {2013-09-14 03:30:36 +0000},
  doi           = {10.1152/jn.00280.2007},
  issn          = {0022-3077},
  journal       = {Journal of neurophysiology},
  keywords      = {Algorithms,Axons,Axons: physiology,Axons: ultrastructure,Cerebellum,Cerebellum: cytology,Cerebellum: ultrastructure,Cost-Benefit Analysis,Dendrites,Dendrites: physiology,Dendrites: ultrastructure,Models, Neurological,Neurons,Neurons: physiology,Neurons: ultrastructure,Purkinje Cells,Purkinje Cells: physiology,Purkinje Cells: ultrastructure,Synapses,Synapses: physiology,Synapses: ultrastructure},
  month         = {5},
  number        = {5},
  pages         = {2320--8},
  pmid          = {18305091},
  title         = {{A cost-benefit analysis of neuronal morphology.}},
  volume        = {99},
  year          = {2008}
}

